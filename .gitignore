# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Виртуальные окружения
.venv/
venv/
env/

# IDE
.idea/
.vscode/

# Снимки-архивы (дублируют содержимое репозитория)
*.rar
*.zip
*.7z

# Временные файлы
*.log
.DS_Store
Thumbs.db

# Логи обучения (чекпоинты и метрики в models_archive/ входят в репозиторий)
logs/

# Устаревшая полная копия проекта (!version_1): в репозиторий идут только
# её исходники (историческая ценность), тяжёлые дубли данных/моделей — нет
!version_1/data/
!version_1/models_archive/
!version_1/results/
!version_1/__pycache__/

# --- экранированные правила для папки с именем, начинающимся с "!" ---
\!version_1/data/
\!version_1/models_archive/
\!version_1/results/
\!version_1/__pycache__/

# Архив (создан аудитом 2026-09-29, ничего не удалено — только перенесено):
# тестовые online-сессии — транзиентные CSV, в git не идут;
# лёгкие тексты/метрики results_old_pipeline — в git (историческая ценность)
archive/online_sessions/

# Онлайн-сессии (транзиентные данные; отчёты дообучений оставляем)
results/online/*
!results/online/*_finetune/
!results/online/*_finetune/**

# Чекпоинты моделей (тяжёлые бинарники ~1-10 МБ x число прогонов).
# В git остаются manifest.json + метрики — модели воспроизводятся перезапуском
# обучения по manifest; локальные чекпоинты нужны только для inference/онлайна.
models_archive/*/checkpoints/best_model.pt
models_archive/*/checkpoints/scalers.pkl

# Транзиентные данные дообучения (exported finetune-сегменты)
data/online_finetune/*
!data/online_finetune/.gitkeep

# Obsidian / заметки-редактор (локальные конфиги, в git не идут)
.obsidian/

# Локальная рабочая папка статьи (Word-документы и временные файлы Word)
draft-article/
~$*
~WRL*.tmp
