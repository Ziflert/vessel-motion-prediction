# Устаревшая полная копия проекта (!version_1): в репозиторий идут только
# её исходники (историческая ценность), тяжёлые дубли данных/моделей — нет
!version_1/data/
!version_1/models_archive/
!version_1/results/
!version_1/__pycache__/

# --- экранированные правила для папки с именем, начинающимся с "!" ---
\!version_1/data/
\!version_1/models_archive/
\!version_1/results/
\!version_1/__pycache__/
